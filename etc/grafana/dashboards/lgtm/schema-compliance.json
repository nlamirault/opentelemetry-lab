      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Findings of `weaver registry live-check` on the telemetry the lab apps emit, checked against the lab registry (`schemas/opentelemetry-lab`) and semantic conventions. Weaver sends each finding as an OTLP log. Start it with `make schema-live-check-up`, see the README."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Violations",
      "description": "Findings that fail `--fail-on violation`.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({service_name=\"weaver\"} | weaver_finding_level=\"violation\" [$__range]))",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          },
          "noValue": "0",
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
